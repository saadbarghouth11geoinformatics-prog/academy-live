# Copy this file to `.env` (or set the same variables in Vercel / Netlify project settings).
# All values below come from your Supabase project (Project Settings → API).
# Do NOT commit real values. Never expose SERVICE_ROLE keys to the browser.

# --- Client (browser) — safe to expose, injected at build time by Vite ---
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# --- Server (SSR / server functions) — same values, non-VITE names ---
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# --- Server-only secret — required for Mr Obeida's dashboard/admin operations ---
# Use the current sb_secret_... key. Keep it server-side and never add a VITE_ prefix.
SUPABASE_SECRET_KEY="YOUR_SB_SECRET_KEY"
# Legacy projects may use this instead:
# SUPABASE_SERVICE_ROLE_KEY="YOUR_LEGACY_SERVICE_ROLE_KEY"

# --- Android APK wrapper — production HTTPS URL, used only while syncing Capacitor ---
CAPACITOR_SERVER_URL="https://YOUR-DOMAIN.com"
